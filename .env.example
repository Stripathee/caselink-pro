# Copy this file to .env and fill it in. Never commit .env.
# Each line is NAME=value, with no spaces around the equals sign.

# Nebius Token Factory API key (Token Factory console -> API keys)
NEBIUS_API_KEY=

# Optional: model overrides. Leave empty to use the defaults in caselink/config.py
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# Optional, used later
TAVILY_API_KEY=
